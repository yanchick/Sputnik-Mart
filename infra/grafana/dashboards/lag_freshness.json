{
  "uid": "sputnik-lag-freshness",
  "title": "Спутник Данные — лаг, свежесть и качество",
  "tags": ["sputnik", "observability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Лаг консьюмеров, сек",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sputnik_consumer_lag",
          "legendFormat": "{{topic}}/{{partition}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Свежесть витрины, сек",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sputnik_data_freshness_seconds",
          "legendFormat": "{{dataset}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Рейтинг качества",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sputnik_quality_score", "legendFormat": "{{dataset}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Деградация качества",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sputnik_quality_degradation_ratio",
          "legendFormat": "{{dataset}}"
        }
      ]
    }
  ]
}

# Спутник Данные — пример переменных окружения.
# Скопируйте в `.env` и при необходимости измените значения.
#
# !!! ВНИМАНИЕ: все значения ниже — ДЕМО-значения для локального стенда.
# Они общеизвестны и непригодны для эксплуатации. Вне демо переопределите
# пароли, `AUTH_SECRET` и `PII_ENCRYPTION_KEY` (см. libs/observability/pii.py:
# `DEFAULT_PII_KEY` существует только ради демо).

# Общие
ENVIRONMENT=local
LOG_LEVEL=INFO

# Профиль запуска docker compose: base | adv | demo
PROFILE=base

# Секрет подписи Bearer-токенов (демо-значение; переопределить вне демо)
AUTH_SECRET=sputnik-demo-secret

# PostgreSQL (identity, catalog, orders, reviews)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sputnik
POSTGRES_PASSWORD=sputnik
POSTGRES_DB=sputnik
POSTGRES_URL=postgresql+asyncpg://sputnik:sputnik@postgres:5432/sputnik

# Redis 7 (rate-limit, идемпотентность, сессии)
REDIS_URL=redis://redis:6379/0

# Redpanda / Kafka API (события commerce.*, sensors.readings*)
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_SCHEMA_REGISTRY_URL=http://redpanda:8081

# ClickHouse (gold-витрины fact_readings, mv_readings_hourly, mart_*)
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DATABASE=sputnik

# MongoDB (метаданные провайдеров)
MONGO_URI=mongodb://mongo:27017
MONGO_DATABASE=catalog_nosql

# MinIO / S3 (bronze, silver, reports, exports)
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=sputnik
MINIO_ROOT_PASSWORD=sputnik123
MINIO_LAKE_BUCKET=lake
MINIO_ACCESS_KEY=sputnik
MINIO_SECRET_KEY=sputnik123

# Airflow (оркестрация DAGов)
AIRFLOW_HOME=/opt/airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://sputnik:sputnik@postgres:5432/airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Генераторы (детерминированность)
SIM_SEED=42

# Защита PII (application-level шифрование и фиксированный срок хранения)
PII_ENCRYPTION_KEY=sputnik-demo-pii-key
PII_RETENTION_MONTHS=12

# Grafana (дашборды и алерты деградации)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
